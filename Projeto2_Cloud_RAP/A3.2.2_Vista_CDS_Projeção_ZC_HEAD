@AccessControl.AuthorizationCheck: #NOT_REQUIRED
@EnduserText.label: 'Projection View - Upload PO'
@Metadata.allowExtensions: true
define Root View entity ZC_PO_UP_HEAD
  provider contract transactional_query
  as projection on ZR_PO_UP_HEAD
{
  key UploadUuid,
      @Semantics.largeobject: { mimeType: 'MimeType',
                                fileName: 'Filename',
                                acceptableMimeTypes: 
                                ['Application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                                 'Application/vnd.ms-excel'],                               
                                contentDispositionPreference: #ATTACHMENT }
      Attachment,
      @Semantics.mimeType: true
      MimeType,
      Filename,
      CreatedBy,
      CreatedAt,
      LastChangedBy,
      LastChangedAt,
      LocalLastChangedAt,
      PurchaseOrder,
      _Itens : redirected to composition Child ZC_PO_UP_ITEM,
      _Logs  : redirected to composition Child ZC_PO_UP_LOG
}
